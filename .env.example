# NOT READ BY THE APP. Kept only as a reference of early design values; see the Configuration section of README.md.
# Google OAuth 2.0 Android Configuration
# Note: Android Identity authorization uses package name (com.financeautomation)
# and debug/release keystore SHA-1 fingerprint registered in Google Cloud Console.
# No client ID is compiled into the Android client binary.
# Web client ID below is optional and only used for backend token verification if needed.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google Drive & Sheets Integration Settings
GOOGLE_DRIVE_FOLDER_NAME=Personal Finance
GOOGLE_SHEET_TITLE_PREFIX=Finance
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive.file

# Application Runtime Defaults
DEFAULT_ACCOUNT=SBI
SETTLE_WINDOW_MILLIS=120000
MAX_SYNC_RETRY_COUNT=8

