<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_month_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_month_burn_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="@dimen/widget_month_padding_horizontal"
    android:paddingTop="@dimen/widget_month_padding_vertical"
    android:paddingEnd="@dimen/widget_month_padding_horizontal"
    android:paddingBottom="@dimen/widget_month_padding_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_month_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_month_burn_placeholder_month"
            android:textColor="@color/widget_month_text_primary"
            android:textSize="@dimen/widget_month_text_small"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_month_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="@dimen/widget_month_gap"
            android:text="@string/widget_month_burn_title"
            android:textColor="@color/widget_month_text_secondary"
            android:textSize="@dimen/widget_month_text_small" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_month_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_month_burn_placeholder_amount"
        android:textColor="@color/widget_month_text_primary"
        android:textSize="@dimen/widget_month_text_amount"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_month_per_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_month_burn_placeholder_per_day"
            android:textColor="@color/widget_month_text_secondary"
            android:textSize="@dimen/widget_month_text_small" />

        <TextView
            android:id="@+id/widget_month_sync"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:paddingStart="@dimen/widget_month_gap"
            android:text="@string/widget_month_burn_up_to_date"
            android:textColor="@color/widget_month_text_secondary"
            android:textSize="@dimen/widget_month_text_small" />
    </LinearLayout>
</LinearLayout>
